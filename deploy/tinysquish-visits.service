[Unit]
Description=TinySquish public visitor counter - loopback, fronted by nginx at /api/visits
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/claude-agent/projects/tinysquish.com/server
Environment="TS_VISITS_HOST=127.0.0.1"
Environment="TS_VISITS_PORT=8111"
ExecStart=/usr/bin/python3 visits.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
